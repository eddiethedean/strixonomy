{
  "name": "strixonomy",
  "displayName": "Strixonomy",
  "description": "Ontology IDE for VS Code powered by Strixonomy. Browse, edit Turtle, query, reason (EL\u2013DL), validate, and diff OWL/RDF/OBO ontologies from the IDE or CI.",
  "version": "0.28.1",
  "publisher": "strixonomy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eddiethedean/strixonomy.git",
    "directory": "extension"
  },
  "homepage": "https://strixonomy.readthedocs.io/en/latest/guides/first-success/",
  "bugs": {
    "url": "https://github.com/eddiethedean/strixonomy/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#111827",
    "theme": "dark"
  },
  "keywords": [
    "ontology",
    "owl",
    "rdf",
    "turtle",
    "obo",
    "protege",
    "sparql",
    "semantic web",
    "knowledge graph",
    "strixonomy",
    "explorer",
    "diagnostics",
    "linter",
    "validate",
    "reasoner",
    "manchester",
    "cursor"
  ],
  "activationEvents": [
    "workspaceContains:**/*.ttl",
    "workspaceContains:**/*.owl",
    "workspaceContains:**/*.owx",
    "workspaceContains:**/*.rdf",
    "workspaceContains:**/*.jsonld",
    "workspaceContains:**/*.json-ld",
    "workspaceContains:**/*.nt",
    "workspaceContains:**/*.nq",
    "workspaceContains:**/*.trig",
    "workspaceContains:**/*.obo",
    "onView:strixonomy.explorer.ontologies"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "obo",
        "aliases": [
          "OBO",
          "obo"
        ],
        "extensions": [
          ".obo"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "obo",
        "scopeName": "source.obo",
        "path": "./syntaxes/obo.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "strixonomy",
          "title": "Strixonomy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "strixonomy": [
        {
          "id": "strixonomy.explorer.ontologies",
          "name": "Ontologies"
        },
        {
          "id": "strixonomy.explorer.classes",
          "name": "Classes"
        },
        {
          "id": "strixonomy.explorer.properties",
          "name": "Properties"
        },
        {
          "id": "strixonomy.explorer.individuals",
          "name": "Individuals"
        },
        {
          "id": "strixonomy.explorer.diagnostics",
          "name": "Diagnostics"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "strixonomy.explorer.ontologies",
        "contents": "Index the workspace to browse ontology documents.\n[Index Workspace](command:strixonomy.indexWorkspace)",
        "when": "!strixonomy:hasOntology"
      },
      {
        "view": "strixonomy.explorer.classes",
        "contents": "Index the workspace to browse classes.\n[Index Workspace](command:strixonomy.indexWorkspace)",
        "when": "!strixonomy:hasOntology"
      },
      {
        "view": "strixonomy.explorer.properties",
        "contents": "Index the workspace to browse properties.\n[Index Workspace](command:strixonomy.indexWorkspace)",
        "when": "!strixonomy:hasOntology"
      },
      {
        "view": "strixonomy.explorer.individuals",
        "contents": "Index the workspace to browse individuals.\n[Index Workspace](command:strixonomy.indexWorkspace)",
        "when": "!strixonomy:hasOntology"
      },
      {
        "view": "strixonomy.explorer.diagnostics",
        "contents": "Index the workspace to see ontology diagnostics.\n[Index Workspace](command:strixonomy.indexWorkspace)",
        "when": "!strixonomy:hasOntology"
      }
    ],
    "commands": [
      {
        "command": "strixonomy.indexWorkspace",
        "title": "Strixonomy: Index Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "strixonomy.refreshExplorer",
        "title": "Strixonomy: Refresh Explorer",
        "icon": "$(refresh)"
      },
      {
        "command": "strixonomy.showEntityInspector",
        "title": "Strixonomy: Show Entity Inspector"
      },
      {
        "command": "strixonomy.jumpToSource",
        "title": "Strixonomy: Jump to Source"
      },
      {
        "command": "strixonomy.openDiagnostic",
        "title": "Strixonomy: Open Diagnostic"
      },
      {
        "command": "strixonomy.openEntity",
        "title": "Open Entity Inspector"
      },
      {
        "command": "strixonomy.createClass",
        "title": "Strixonomy: Create Class"
      },
      {
        "command": "strixonomy.createProperty",
        "title": "Strixonomy: Create Property"
      },
      {
        "command": "strixonomy.createIndividual",
