        "title": "Strixonomy: Run Reasoner"
      },
      {
        "command": "strixonomy.runOwlmakeWorkflow",
        "title": "Strixonomy: Run Workflow (owlmake)"
      },
      {
        "command": "strixonomy.plugins.runCommand",
        "title": "Strixonomy: Plugins: Run Command\u2026"
      },
      {
        "command": "strixonomy.plugins.openView",
        "title": "Strixonomy: Plugins: Open View\u2026"
      },
      {
        "command": "strixonomy.plugins.openPreferences",
        "title": "Strixonomy: Plugins: Open Preferences\u2026"
      },
