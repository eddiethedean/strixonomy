    "menus": {
      "view/title": [
        {
          "command": "strixonomy.refreshExplorer",
          "when": "view =~ /^strixonomy\\.explorer\\./",
          "group": "navigation"
        },
        {
          "command": "strixonomy.newOntology",
          "when": "view =~ /^strixonomy\\.explorer\\./",
          "group": "navigation@1"
        },
        {
          "command": "strixonomy.searchEntities",
          "when": "view =~ /^strixonomy\\.explorer\\./ && strixonomy:hasOntology",
          "group": "navigation@2"
        },
        {
          "command": "strixonomy.synchronizeReasoner",
          "when": "view =~ /^strixonomy\\.explorer\\./ && strixonomy:hasOntology",
          "group": "navigation@3"
        },
        {
          "command": "strixonomy.showMetrics",
          "when": "view =~ /^strixonomy\\.explorer\\./ && strixonomy:hasOntology",
          "group": "navigation@4"
        },
        {
          "command": "strixonomy.openPreferences",
          "when": "view =~ /^strixonomy\\.explorer\\./",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "strixonomy.jumpToSource",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "navigation"
        },
        {
          "command": "strixonomy.openEntity",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "inline"
        },
        {
          "command": "strixonomy.openNeighborhoodGraph",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "navigation"
        },
        {
          "command": "strixonomy.openGraph",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "navigation"
        },
        {
          "command": "strixonomy.findEntityUsages",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "2_edit"
        },
        {
          "command": "strixonomy.renameEntityIri",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "2_edit"
        },
        {
          "command": "strixonomy.deleteEntity",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "2_edit"
        },
        {
          "command": "strixonomy.manageImports",
          "when": "view == strixonomy.explorer.ontologies && viewItem == strixonomyTurtleDocument",
          "group": "2_edit"
        },
        {
          "command": "strixonomy.createClass",
          "when": "view == strixonomy.explorer.classes",
          "group": "navigation"
        },
        {
          "command": "strixonomy.createIndividual",
          "when": "view == strixonomy.explorer.individuals",
          "group": "navigation"
        },
        {
          "command": "strixonomy.createProperty",
          "when": "view == strixonomy.explorer.properties",
          "group": "navigation"
        },
        {
          "command": "strixonomy.copyEntityIri",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "3_copy"
        },
        {
          "command": "strixonomy.copyEntityShortForm",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "3_copy"
        },
        {
          "command": "strixonomy.mergeEntities",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "2_edit"
        },
        {
          "command": "strixonomy.replaceEntity",
          "when": "view =~ /^strixonomy\\.explorer\\./ && viewItem == strixonomyEntity",
          "group": "2_edit"
        }
      ],
      "editor/title": [
        {
          "command": "strixonomy.newOntology",
          "group": "navigation@1"
        },
        {
          "command": "strixonomy.searchEntities",
          "when": "strixonomy:hasOntology",
          "group": "navigation@2"
        },
        {
          "command": "strixonomy.synchronizeReasoner",
          "when": "strixonomy:hasOntology",
          "group": "navigation@3"
        },
        {
          "command": "strixonomy.showMetrics",
          "when": "strixonomy:hasOntology",
          "group": "navigation@4"
        },
        {
          "command": "strixonomy.openPreferences",
          "group": "navigation@5"
        }
      ],
      "explorer/context": [
        {
          "command": "strixonomy.openOntology",
          "group": "strixonomy@1"
        },
        {
          "command": "strixonomy.newOntology",
          "group": "strixonomy@2"
        }
      ],
      "commandPalette": [
        {
          "command": "strixonomy.saveAs",
          "when": "strixonomy:hasOntology"
        },
        {
          "command": "strixonomy.exportOntology",
          "when": "strixonomy:hasOntology"
        },
        {
          "command": "strixonomy.searchEntities",
          "when": "strixonomy:hasOntology"
        },
        {
          "command": "strixonomy.copyEntityIri",
          "when": "strixonomy:hasSelection"
        },
        {
          "command": "strixonomy.copyEntityShortForm",
          "when": "strixonomy:hasSelection"
        },
        {
          "command": "strixonomy.mergeEntities",
          "when": "strixonomy:hasSelection && strixonomy:canEditSelection"
        },
        {
          "command": "strixonomy.replaceEntity",
          "when": "strixonomy:hasSelection && strixonomy:canEditSelection"
        },
        {
          "command": "strixonomy.stopReasoner",
          "when": "strixonomy:reasonerRunning"
        },
        {
          "command": "strixonomy.startReasoner",
          "when": "strixonomy:hasOntology && !strixonomy:reasonerRunning"
        },
        {
          "command": "strixonomy.validateWorkspace",
          "when": "strixonomy:hasOntology"
        },
        {
          "command": "strixonomy.exportDiagnostics",
          "when": "strixonomy:hasOntology"
        }
      ]
    },
    "keybindings": [
      {
        "command": "strixonomy.searchEntities",
        "key": "ctrl+k ctrl+e",
        "mac": "cmd+k cmd+e",
        "when": "strixonomy:hasOntology"
      },
      {
        "command": "strixonomy.openClassGraph",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "strixonomy:hasOntology"
      },
      {
        "command": "strixonomy.showExplanation",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "strixonomy:hasSelection"
      },
      {
        "command": "strixonomy.synchronizeReasoner",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "strixonomy:hasOntology"
      },
      {
        "command": "strixonomy.showEntityInspector",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "strixonomy:hasOntology"
      }
    ],
    "configuration": {
      "title": "Strixonomy",
      "properties": {
        "strixonomy.lspPath": {
          "type": "string",
          "default": "",
          "description": "Trusted workspaces only: path to the strixonomy-lsp binary. Ignored in Restricted Mode. When empty, the bundled server or PATH is used."
        },
        "strixonomy.autoIndexOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Legacy no-op. Indexing is driven by the language server on workspace open; kept for compatibility with older settings."
        },
        "strixonomy.queryHistoryLimit": {
          "type": "number",
          "default": 20,
          "description": "Maximum number of recent queries kept in the Query Workbench history."
        },
        "strixonomy.reasoner.default": {
          "type": "string",
          "enum": [
            "el",
            "rl",
            "rdfs",
            "dl",
            "auto"
          ],
          "default": "el",
          "description": "Default reasoner profile for Run Reasoner (el, rl, rdfs, dl, auto)."
        },
        "strixonomy.reasoner.autoProfile": {
          "type": "boolean",
          "default": true,
          "description": "Emit profile-detection warnings when running the reasoner."
        },
        "strixonomy.hierarchy.mode": {
          "type": "string",
          "enum": [
            "asserted",
            "inferred",
            "combined"
          ],
          "default": "asserted",
          "description": "Class hierarchy display mode in the explorer after classification."
        },
        "strixonomy.indexCache": {
          "type": "boolean",
          "default": false,
          "description": "Persist ontology parse snapshots under .strixonomy/cache/ (recommended gitignore)."
        },
        "strixonomy.robotPath": {
          "type": "string",
          "default": "",
          "description": "Trusted workspaces only: path to ROBOT CLI or JAR. When empty, ROBOT is resolved from PATH."
        },
        "strixonomy.diagnostics.rules": {
          "type": "object",
          "default": {},
          "description": "Per-rule diagnostic overrides (enabled, severity). Mirrors `.strixonomy/diagnostics.toml` [rules.*] entries; file config takes precedence when present."
        }
      }
    }
  },
  "scripts": {
    "build:webview": "npm --prefix webview-ui ci && npm --prefix webview-ui run build",
    "compile": "npm run build:webview && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "npm run compile && rm -rf dist-test && tsc -p tsconfig.test.json && node --test --test-concurrency=1 dist-test/**/*.test.js dist-test/**/*.e2e.test.js",
    "compile:vscode-test": "tsc -p tsconfig.vscode-test.json",
    "test:vscode": "node out/test/runVscodeTest.js",
    "package": "npm run compile && vsce package --no-dependencies"
