      },
      {
        "command": "strixonomy.searchEntities",
        "title": "Strixonomy: Search Entities",
        "icon": "$(search)"
      },
      {
        "command": "strixonomy.openPreferences",
        "title": "Strixonomy: Open Preferences",
        "icon": "$(settings-gear)"
      },
      {
        "command": "strixonomy.copyEntityIri",
        "title": "Strixonomy: Copy Entity IRI"
      },
      {
        "command": "strixonomy.copyEntityShortForm",
