        "title": "Strixonomy: Reload Imports"
      },
      {
        "command": "strixonomy.resetLayout",
        "title": "Strixonomy: Reset Layout"
      },
      {
        "command": "strixonomy.openNeighborhoodGraph",
        "title": "Strixonomy: Open Neighborhood Graph"
      },
      {
        "command": "strixonomy.openGraph",
        "title": "Strixonomy: Open Graph"
