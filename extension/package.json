        "title": "Strixonomy: Save Perspective"
      },
      {
        "command": "strixonomy.showInspectorPanel",
        "title": "Strixonomy: Show Inspector Panel"
      },
      {
        "command": "strixonomy.showQueryPanel",
        "title": "Strixonomy: Show Query Panel"
      },
      {
        "command": "strixonomy.showReasonerPanel",
        "title": "Strixonomy: Show Reasoner Panel"
      },
      {
        "command": "strixonomy.showExplanationPanel",
        "title": "Strixonomy: Show Explanation Panel"
